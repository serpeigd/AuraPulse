# These two variables are read via os.environ, not an auto-loaded .env file --
# python-dotenv is a listed dependency but nothing calls load_dotenv() yet, so
# copying this to .env and editing it has no effect by itself. Export them in
# your shell instead (or source .env yourself: `set -a; source .env; set +a`).
# Never commit a real .env file.
# No API keys required — classification runs against a local Ollama
# instance (https://ollama.com), which needs no credentials.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
