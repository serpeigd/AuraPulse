# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Data (raw Yelp dataset must never be committed; keep processed/ out too unless small artifacts are explicitly needed)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Escalation records: runtime output from scripts/run_pipeline.py, not code
data/escalations/*
!data/escalations/.gitkeep

# Draft approve/reject decisions: runtime output from app/streamlit_app.py, not code
data/decisions/*
!data/decisions/.gitkeep

# OS / editor
.DS_Store
.vscode/
.idea/

# Claude Code: local session state, not project config. launch.json (how to
# preview app/streamlit_app.py) is the only .claude/ file meant to be shared.
.claude/settings.local.json
.claude/scheduled_tasks.lock
